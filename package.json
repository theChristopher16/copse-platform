{
  "name": "copse-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "🌳 Copse - Multi-tenant SaaS platform for organizations (Scouts, Sports, Schools, Business, ICS/OT)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:web": "cd copse-web && npm run dev",
    "build:web": "cd copse-web && npm run build",
    "dev:functions": "cd copse-functions && npm run dev",
    "build:functions": "cd copse-functions && npm run build",
    "deploy:web": "cd copse-web && npm run build && firebase deploy --only hosting",
    "deploy:functions": "cd copse-functions && npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.5.2",
    "@types/react-router-dom": "^5.3.3",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.7",
    "firebase": "^12.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
